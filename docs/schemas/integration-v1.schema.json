{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Hill-To-Die-On/Star-wars-FFG-game-system/main/docs/schemas/integration-v1.schema.json",
  "title": "Star Wars FFG interchange package v1",
  "description": "Data-only interchange for player characters, community rule packs and mixed bundles.",
  "$ref": "#/$defs/package",
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://"
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "book": { "type": "string", "maxLength": 240 },
        "page": { "type": "string", "maxLength": 40 },
        "table": { "type": "string", "maxLength": 240 },
        "id": { "type": "string", "maxLength": 240 }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "max": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "characteristic": {
      "type": "string",
      "enum": ["brawn", "agility", "intellect", "cunning", "willpower", "presence"]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rank": { "type": "integer", "minimum": 0, "maximum": 5 },
        "career": { "type": "boolean" },
        "group": { "type": "boolean" },
        "characteristic": { "$ref": "#/$defs/characteristic" }
      }
    },
    "customSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "characteristic", "type", "rank", "career", "group"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "characteristic": { "$ref": "#/$defs/characteristic" },
        "type": { "type": "string", "enum": ["general", "melee", "ranged"] },
        "rank": { "type": "integer", "minimum": 0, "maximum": 5 },
        "career": { "type": "boolean" },
        "group": { "type": "boolean" }
      }
    },
    "motivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 4000 },
        "active": { "type": "boolean" },
        "source": { "$ref": "#/$defs/sourceReference" }
      }
    },
    "characterSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "enum": ["auto", "frontier", "rebellion", "mystic"]
        },
        "line": { "type": "string", "enum": ["edge", "age", "force"] },
        "phase": { "type": "string", "enum": ["creation", "play"] },
        "species": { "type": "string", "maxLength": 100000 },
        "career": { "type": "string", "maxLength": 100000 },
        "motivation": { "type": "string", "maxLength": 100000 },
        "motivations": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/motivation" }
        },
        "biography": { "type": "string", "maxLength": 100000 },
        "characteristics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "brawn": { "type": "integer", "minimum": 0, "maximum": 7 },
            "agility": { "type": "integer", "minimum": 0, "maximum": 7 },
            "intellect": { "type": "integer", "minimum": 0, "maximum": 7 },
            "cunning": { "type": "integer", "minimum": 0, "maximum": 7 },
            "willpower": { "type": "integer", "minimum": 0, "maximum": 7 },
            "presence": { "type": "integer", "minimum": 0, "maximum": 7 }
          }
        },
        "skills": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "astrogation",
              "athletics",
              "brawl",
              "charm",
              "coercion",
              "computers",
              "cool",
              "coordination",
              "deception",
              "discipline",
              "gunnery",
              "leadership",
              "lightsaber",
              "mechanics",
              "medicine",
              "melee",
              "negotiation",
              "perception",
              "pilotingPlanetary",
              "pilotingSpace",
              "rangedLight",
              "rangedHeavy",
              "resilience",
              "skulduggery",
              "stealth",
              "streetwise",
              "survival",
              "vigilance",
              "coreWorlds",
              "education",
              "lore",
              "outerRim",
              "underworld",
              "warfare",
              "xenology"
            ]
          },
          "additionalProperties": { "$ref": "#/$defs/skill" }
        },
        "customSkills": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/customSkill" }
        },
        "wounds": { "$ref": "#/$defs/resource" },
        "strain": { "$ref": "#/$defs/resource" },
        "soak": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "defense": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "melee": { "type": "integer", "minimum": 0, "maximum": 4 },
            "ranged": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        },
        "credits": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
        "xp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "available": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "total": { "type": "integer", "minimum": 0, "maximum": 100000 }
          }
        },
        "forceRating": { "type": "integer", "minimum": 0, "maximum": 10 },
        "committedForce": { "type": "integer", "minimum": 0, "maximum": 10 },
        "obligation": { "type": "object" },
        "duty": { "type": "object" },
        "morality": { "type": "object" },
        "groupSize": { "type": "integer", "minimum": 0, "maximum": 100 },
        "criticals": { "type": "array", "maxItems": 10000 },
        "advancement": { "type": "array", "maxItems": 1000 },
        "creation": { "type": "object" },
        "source": { "$ref": "#/$defs/sourceReference" },
        "incomplete": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "maxLength": 100000 }
        }
      }
    },
    "itemType": {
      "type": "string",
      "enum": [
        "weapon",
        "armor",
        "gear",
        "talent",
        "forcePower",
        "species",
        "career",
        "specialization",
        "signatureAbility",
        "attachment",
        "reference"
      ]
    },
    "itemSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "maxLength": 50000 },
        "quantity": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "price": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
        "rarity": { "type": "integer", "minimum": 0, "maximum": 20 },
        "encumbrance": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "hardpoints": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "restricted": { "type": "boolean" },
        "equipped": { "type": "boolean" },
        "skill": { "type": "string", "maxLength": 100000 },
        "damage": { "type": "string", "maxLength": 100000 },
        "critical": { "type": "integer", "minimum": 0, "maximum": 10 },
        "range": { "type": "string", "maxLength": 100000 },
        "qualities": { "type": "string", "maxLength": 100000 },
        "scale": { "type": "string", "maxLength": 100000 },
        "soak": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "defense": { "type": "integer", "minimum": 0, "maximum": 4 },
        "rank": { "type": "integer", "minimum": 0, "maximum": 100 },
        "ranked": { "type": "boolean" },
        "activation": { "type": "string", "maxLength": 100000 },
        "career": { "type": "string", "maxLength": 100000 },
        "careerSkills": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "maxLength": 100000 }
        },
        "forceRating": { "type": "integer", "minimum": 0, "maximum": 10 },
        "universal": { "type": "boolean" },
        "grantedForceRating": { "type": "integer", "minimum": 0, "maximum": 10 },
        "eligibleCareers": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "maxLength": 100000 }
        },
        "abilityCategory": { "type": "string", "maxLength": 100000 },
        "matchingNodes": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "boolean" }
        },
        "linkedSpecializationId": { "type": "string", "maxLength": 100000 },
        "tree": { "type": "object" },
        "source": { "$ref": "#/$defs/sourceReference" },
        "metadata": { "type": "object" },
        "incomplete": {
          "type": "array",
          "maxItems": 10000,
          "items": { "type": "string", "maxLength": 100000 }
        }
      }
    },
    "embeddedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "system"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^[A-Za-z0-9]{16}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "$ref": "#/$defs/itemType" },
        "img": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "system": { "$ref": "#/$defs/itemSystem" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name", "type", "system"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "$ref": "#/$defs/itemType" },
        "img": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "system": { "$ref": "#/$defs/itemSystem" }
      }
    },
    "characterPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "system"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "type": { "const": "character" },
        "img": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "system": { "$ref": "#/$defs/characterSystem" },
        "items": {
          "type": "array",
          "maxItems": 250,
          "items": { "$ref": "#/$defs/embeddedItem" }
        }
      }
    },
    "rulePackPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "rules"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "characterPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "kind", "source", "payload"],
      "properties": {
        "format": { "const": "star-wars-ffg-interchange" },
        "version": { "const": 1 },
        "kind": { "const": "character" },
        "source": { "$ref": "#/$defs/source" },
        "payload": { "$ref": "#/$defs/characterPayload" }
      }
    },
    "rulePackPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "kind", "source", "payload"],
      "properties": {
        "format": { "const": "star-wars-ffg-interchange" },
        "version": { "const": 1 },
        "kind": { "const": "rulePack" },
        "source": { "$ref": "#/$defs/source" },
        "payload": { "$ref": "#/$defs/rulePackPayload" }
      }
    },
    "leafPackage": {
      "oneOf": [
        { "$ref": "#/$defs/characterPackage" },
        { "$ref": "#/$defs/rulePackPackage" }
      ]
    },
    "bundlePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "kind", "source", "payload"],
      "properties": {
        "format": { "const": "star-wars-ffg-interchange" },
        "version": { "const": 1 },
        "kind": { "const": "bundle" },
        "source": { "$ref": "#/$defs/source" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packages"],
          "properties": {
            "packages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": { "$ref": "#/$defs/leafPackage" }
            }
          }
        }
      }
    },
    "package": {
      "oneOf": [
        { "$ref": "#/$defs/characterPackage" },
        { "$ref": "#/$defs/rulePackPackage" },
        { "$ref": "#/$defs/bundlePackage" }
      ]
    }
  }
}
