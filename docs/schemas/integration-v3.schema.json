{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Hill-To-Die-On/Star-wars-FFG-game-system/main/docs/schemas/integration-v3.schema.json",
  "title": "Star Wars FFG actor-group interchange package v3",
  "description": "Data-only interchange for an authored group of Actors, stable source nodes, canvas roles and exact directed relationships. Runtime validation remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "kind", "source", "payload"],
  "properties": {
    "format": { "const": "star-wars-ffg-interchange" },
    "version": { "const": 3 },
    "kind": { "const": "actorGroup" },
    "source": { "$ref": "integration-v1.schema.json#/$defs/source" },
    "payload": { "$ref": "#/$defs/actorGroupPayload" }
  },
  "$defs": {
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
    },
    "actorEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor"],
      "properties": {
        "id": { "$ref": "#/$defs/externalId" },
        "actor": { "$ref": "integration-v2.schema.json#/$defs/actorPayload" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "position", "actorRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/externalId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "role": {
          "enum": [
            "player-character",
            "ally",
            "neutral",
            "enemy-minion",
            "enemy-rival",
            "enemy-nemesis",
            "organisation",
            "vehicle",
            "location"
          ]
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "y": { "type": "integer", "minimum": 0, "maximum": 100000 }
          }
        },
        "actorRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/externalId" }
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromNodeId", "toNodeId", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/externalId" },
        "fromNodeId": { "$ref": "#/$defs/externalId" },
        "toNodeId": { "$ref": "#/$defs/externalId" },
        "kind": {
          "enum": [
            "commands",
            "reports-to",
            "employs",
            "protects",
            "pursues",
            "allied-with",
            "rivals",
            "related-to",
            "member-of",
            "located-at",
            "owns",
            "pilots",
            "crews",
            "aboard",
            "docked-at",
            "based-at"
          ]
        },
        "label": { "type": "string", "maxLength": 120 }
      }
    },
    "actorGroupPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "actors", "nodes", "relationships"],
      "properties": {
        "id": { "$ref": "#/$defs/externalId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "actors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/actorEntry" }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/node" }
        },
        "relationships": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/relationship" }
        }
      }
    }
  }
}
