<div class="sf-shell" data-theme="{{themeKey}}" data-section="{{activeTab}}">
  <header class="sf-header">
    <div class="sf-wordmark">
<span class="sf-orbit" aria-hidden="true">✦</span> STAR WARS FFG <small>NARRATIVE TOOLKIT</small>
</div>
    <label class="sf-theme-select">Sheet theme<select name="system.theme">{{selectOptions themes selected=system.theme}}</select>
</label>
    <div class="sf-identity">
<div class="sf-portrait-frame">
<img src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
<span class="sf-portrait-marks" aria-hidden="true"></span>
</div>
<div>
<span class="sf-eyebrow">{{theme.line}} / {{actor.type}}</span>
<input class="sf-name" name="name" value="{{actor.name}}" aria-label="Name">
<p>{{theme.tagline}}</p>
</div>
</div>
    <div class="sf-header-meta">
{{#if isVehicle}}<label>Model<input name="system.model" value="{{system.model}}">
</label>
<label>Manufacturer<input name="system.manufacturer" value="{{system.manufacturer}}">
</label>{{else}}{{#if isCharacter}}<div class="sf-origin-picker" data-origin-picker="species" data-current="{{system.species}}">
<span class="sf-origin-label">Species{{#if originsLocked}} <i class="fa-solid fa-lock" aria-hidden="true"></i>{{/if}}</span>
<div class="sf-origin-control">
{{#if originEditable}}<input type="search" value="{{system.species}}" placeholder="Choose species…" autocomplete="off" role="combobox" aria-label="Species" aria-autocomplete="list" aria-expanded="false" data-origin-search>
<button type="button" class="sf-origin-toggle" data-origin-toggle aria-label="Show species choices" aria-expanded="false"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{else}}<input type="text" value="{{system.species}}" aria-label="Species" readonly>{{/if}}
</div>
{{#if originEditable}}<div class="sf-origin-menu" role="listbox" aria-label="Species choices" data-origin-menu hidden>
{{#each speciesOptions}}<button type="button" role="option" aria-selected="{{selected}}" data-action="selectOrigin" data-kind="species" data-document-id="{{id}}"><strong>{{name}}</strong><small>{{#if source.book}}{{source.book}}{{else}}Unreferenced source{{/if}}{{#if source.page}} · p. {{source.page}}{{/if}}</small></button>{{/each}}
<p data-origin-empty hidden>No valid species matches that search.</p>
</div>{{/if}}
<small class="sf-origin-help">{{originHelp}}</small>
</div>
<div class="sf-origin-picker" data-origin-picker="career" data-current="{{system.career}}">
<span class="sf-origin-label">Career{{#if originsLocked}} <i class="fa-solid fa-lock" aria-hidden="true"></i>{{/if}}</span>
<div class="sf-origin-control">
{{#if originEditable}}<input type="search" value="{{system.career}}" placeholder="Choose career…" autocomplete="off" role="combobox" aria-label="Career" aria-autocomplete="list" aria-expanded="false" data-origin-search>
<button type="button" class="sf-origin-toggle" data-origin-toggle aria-label="Show career choices" aria-expanded="false"><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{else}}<input type="text" value="{{system.career}}" aria-label="Career" readonly>{{/if}}
</div>
{{#if originEditable}}<div class="sf-origin-menu" role="listbox" aria-label="Career choices" data-origin-menu hidden>
{{#each careerOptions}}<button type="button" role="option" aria-selected="{{selected}}" data-action="selectOrigin" data-kind="career" data-document-id="{{id}}"><strong>{{name}}</strong><small>{{#if source.book}}{{source.book}}{{else}}Unreferenced source{{/if}}{{#if source.page}} · p. {{source.page}}{{/if}}</small></button>{{/each}}
<p data-origin-empty hidden>No valid career matches that search.</p>
</div>{{/if}}
<small class="sf-origin-help">{{originHelp}}</small>
</div>
<div class="sf-origin-rules"><span>Campaign rules</span><strong>{{campaignRulesLabel}}</strong><small>Chosen by the GM for this adventure.</small></div>
{{else}}<label>Species<input name="system.species" value="{{system.species}}">
</label>
<label>Career<input name="system.career" value="{{system.career}}">
</label>
<div class="sf-origin-rules"><span>Campaign rules</span><strong>{{campaignRulesLabel}}</strong><small>Chosen by the GM for this adventure.</small></div>{{/if}}{{/if}}
</div>
  </header>
  <nav class="sf-tabs" aria-label="Character sections">
{{#each tabs}}<button type="button" data-action="switchSection" data-tab="{{id}}" aria-selected="{{active}}" class="{{#if active}}active{{/if}}">{{label}}</button>{{/each}}
</nav>
  <main class="sf-content">
    {{#if system.incomplete.length}}<aside class="sf-notice">
<strong>Source check needed</strong>
<span>
{{#each system.incomplete}}{{this}}{{#unless @last}} · {{/unless}}{{/each}}
</span>
<button type="button" data-action="verifySource">Confirm source checks</button>
</aside>{{/if}}
    {{#if overview}}
      {{#unless isVehicle}}<section class="sf-characteristics" aria-label="Characteristics">
{{#each characteristics}}<label>
<span>{{label}}</span>
<input name="system.characteristics.{{key}}" type="number" value="{{value}}" min="0" max="7" {{#if ../characteristicsLocked}}readonly{{/if}}>
{{#if ../creation}}<button type="button" data-action="buyCharacteristic" data-characteristic="{{key}}" title="Purchase next characteristic rating with XP">+ XP</button>{{/if}}
</label>{{/each}}
</section>{{/unless}}
      <div class="sf-two-col">
<section class="sf-panel">
<h2>
{{#if isVehicle}}Condition{{else}}Vitals{{/if}}
</h2>
<div class="sf-resources">
{{#each resources}}<div class="sf-resource {{#if exceeded}}exceeded{{/if}}">
<h3>{{label}}</h3>
<label>Current<input type="number" min="0" name="system.{{key}}.value" value="{{value}}">
</label>
<span>/</span>
<label>Threshold<input type="number" min="0" name="system.{{key}}.max" value="{{max}}">
</label>
{{#if exceeded}}<small>Threshold exceeded</small>{{/if}}
</div>{{/each}}
</div>
<button type="button" class="sf-primary" data-action="damage">Apply damage</button>
<p class="sf-hint">Damage accumulates. A threshold is exceeded only when the current value is greater.</p>
</section>
      <section class="sf-panel">
<h2>
{{#if isVehicle}}Flight profile{{else}}Readiness{{/if}}
</h2>
<div class="sf-form-grid">
{{#if isVehicle}}{{#each vehicleFields}}<label>{{label}}<input type="number" name="system.{{key}}" value="{{value}}">
</label>{{/each}}
<label>Speed<input type="number" min="0" name="system.speed.value" value="{{system.speed.value}}">
</label>
<label>Maximum speed<input type="number" min="0" name="system.speed.max" value="{{system.speed.max}}">
</label>{{else}}<label>Soak<input type="number" min="0" name="system.soak" value="{{system.soak}}">
</label>
<label>Melee defense<input type="number" min="0" max="4" name="system.defense.melee" value="{{system.defense.melee}}">
</label>
<label>Ranged defense<input type="number" min="0" max="4" name="system.defense.ranged" value="{{system.defense.ranged}}">
</label>
<label>Force rating<input type="number" min="0" name="system.forceRating" value="{{system.forceRating}}">
</label>
<label>Committed dice<input type="number" min="0" name="system.committedForce" value="{{system.committedForce}}">
</label>
<div class="sf-credit-field"><label>Credits<input type="number" min="0" name="system.credits" value="{{system.credits}}">
</label>{{#if pocketMoneyPending}}<button type="button" data-action="finishStartingFunds"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i> Finish starting funds</button><small>Roll d100 after the starting loadout is final.</small>{{/if}}</div>{{/if}}
</div>
{{#unless isVehicle}}<div class="sf-button-row">
<button type="button" data-action="force">Roll Force</button>
<button type="button" data-action="skill" data-skill="cool">Cool</button>
<button type="button" data-action="skill" data-skill="vigilance">Vigilance</button>
</div>{{/unless}}</section>
</div>
      {{#if isVehicle}}<section class="sf-panel">
<h2>Deflector shields</h2>
<div class="sf-form-grid">
{{#each shields}}<label>{{key}}<input type="number" min="0" max="4" name="system.shields.{{key}}" value="{{value}}">
</label>{{/each}}
</div>
<div class="sf-form-grid">
<label>Crew<input name="system.crew" value="{{system.crew}}">
</label>
<label>Passengers<input name="system.passengers" value="{{system.passengers}}">
</label>
<label>Hyperdrive<input name="system.hyperdrive" value="{{system.hyperdrive}}">
</label>
<label>Cargo<input name="system.cargo" value="{{system.cargo}}">
</label>
</div>
</section>{{else}}<section class="sf-panel">
<h2>A place in the galaxy</h2>
<div class="sf-form-grid">
{{#if campaign.obligation}}<fieldset>
<legend>Obligation</legend>
<label>Type<input name="system.obligation.label" value="{{system.obligation.label}}">
</label>
<label>Value<input type="number" name="system.obligation.value" value="{{system.obligation.value}}" min="0" max="100">
</label>
</fieldset>{{/if}}{{#if campaign.duty}}<fieldset>
<legend>Duty</legend>
<label>Type<input name="system.duty.label" value="{{system.duty.label}}">
</label>
<label>Value<input type="number" name="system.duty.value" value="{{system.duty.value}}" min="0" max="100">
</label>
<label>Contribution<input type="number" name="system.duty.contribution" value="{{system.duty.contribution}}" min="0">
</label>
</fieldset>{{/if}}{{#if campaign.morality}}<fieldset>
<legend>Morality</legend>
<label>Value<input type="number" name="system.morality.value" value="{{system.morality.value}}" min="0" max="100">
</label>
<label>Conflict<input type="number" name="system.morality.conflict" value="{{system.morality.conflict}}" min="0">
</label>
</fieldset>{{/if}}
</div>
</section>{{/if}}
      {{#if isMinion}}<section class="sf-panel">
<h2>Minion group</h2>
<label>Starting members<input type="number" min="1" name="system.groupSize" value="{{system.groupSize}}">
</label>
<p>{{minions.remaining}} active · {{minions.defeated}} defeated · group skill rank {{minions.rank}}</p>
<p class="sf-hint">Enter the wound threshold of one member above. Mark trained group skills on the Skills tab.</p>
</section>{{/if}}
    {{/if}}
    {{#if showSkills}}<section class="sf-panel sf-skills-panel">
<div class="sf-section-heading"><h2>Skills <small>Click a skill to build and roll its pool</small></h2><span class="sf-skill-view-toggle" role="group" aria-label="Skill order">{{#each skillViews}}<button type="button" data-action="setSkillView" data-skill-view="{{id}}" class="{{#if active}}active{{/if}}" aria-pressed="{{active}}">{{label}}</button>{{/each}}</span><span class="sf-skill-legend"><b>C</b> Career · <i class="fa-solid fa-dice" aria-hidden="true"></i> Roll</span></div>
<div class="sf-skill-sheet {{#if isMinion}}minion{{/if}}">
{{#each skillColumns}}<div class="sf-skill-column">
<div class="sf-skill-compact-head"><span>Skill / pool</span><span>Char</span><span>{{#if ../isMinion}}C/G{{else}}C{{/if}}</span><span>Rank</span><span></span></div>
{{#each sections}}<section class="sf-skill-group">
<h3><span>{{label}}</span>{{#if addCustom}}<button type="button" data-action="addCustomSkill" title="Add a custom skill" aria-label="Add a custom skill"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{/if}}</h3>
{{#each skills}}<div class="sf-skill-compact-row {{#if showGroup}}minion{{/if}} {{#if custom}}custom{{/if}}">
{{#if custom}}<span class="sf-custom-skill-name-cell">
<button type="button" class="sf-skill-roll sf-skill-roll-compact" data-action="skill" data-skill="{{key}}" aria-label="Roll {{label}} using {{characteristicLabel}} {{characteristicValue}} and rank {{rank}}">
<strong title="{{label}}">{{label}}</strong>
<span class="sf-inline-pool" aria-label="{{pool}}">{{#each poolDice}}<span class="sf-die-count" title="{{count}} {{label}} dice"><b>{{count}}</b><i class="sf-die-shape sf-die-{{key}}" aria-hidden="true"></i><span class="sr-only">{{label}}</span></span>{{else}}<small>—</small>{{/each}}</span>
<i class="fa-solid fa-dice sf-compact-roll-cue" aria-hidden="true"></i>
</button>
<span class="sf-custom-skill-hover-actions" aria-label="Custom skill actions">
<button type="button" data-action="editCustomSkill" data-custom-id="{{id}}" title="Edit {{label}}" aria-label="Edit {{label}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
<button type="button" data-action="removeCustomSkill" data-custom-id="{{id}}" title="Remove {{label}}" aria-label="Remove {{label}}"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
</span>
</span>
<span class="sf-skill-characteristic sf-custom-characteristic" title="{{characteristicLabel}}">{{characteristicShort}}</span>
<span class="sf-paper-checks"><span class="sf-paper-check sf-readonly-check {{#if career}}checked{{/if}}" title="{{#if career}}Career skill{{else}}Not a career skill{{/if}}"><span>C</span></span>
{{#if showGroup}}<span class="sf-paper-check sf-readonly-check {{#if group}}checked{{/if}}" title="{{#if group}}Minion group skill{{else}}Not a minion group skill{{/if}}"><span>G</span></span>{{/if}}</span>
<span class="sf-skill-rank sf-skill-rank-display" aria-label="{{label}} rank {{rank}}">{{rank}}</span>
{{else}}
<button type="button" class="sf-skill-roll sf-skill-roll-compact" data-action="skill" data-skill="{{key}}" aria-label="Roll {{label}} using {{characteristicLabel}} {{characteristicValue}} and rank {{rank}}">
<strong title="{{label}}">{{label}}</strong>
<span class="sf-inline-pool" aria-label="{{pool}}">{{#each poolDice}}<span class="sf-die-count" title="{{count}} {{label}} dice"><b>{{count}}</b><i class="sf-die-shape sf-die-{{key}}" aria-hidden="true"></i><span class="sr-only">{{label}}</span></span>{{else}}<small>—</small>{{/each}}</span>
<i class="fa-solid fa-dice sf-compact-roll-cue" aria-hidden="true"></i>
</button>
<select class="sf-skill-characteristic" name="{{path}}.characteristic" aria-label="{{label}} characteristic" title="{{characteristicLabel}}">{{selectOptions characteristicShortOptions selected=characteristic}}</select>
<span class="sf-paper-checks"><label class="sf-paper-check" title="Career skill"><input type="checkbox" name="{{path}}.career" {{checked career}} aria-label="{{label}} career skill" {{#if careerLocked}}disabled{{/if}}><span>C</span></label>
{{#if showGroup}}<label class="sf-paper-check" title="Minion group skill"><input type="checkbox" name="{{path}}.group" {{checked group}} aria-label="{{label}} minion group skill"><span>G</span></label>{{/if}}</span>
<input class="sf-skill-rank" type="number" name="{{path}}.rank" min="0" max="{{cap}}" value="{{rank}}" aria-label="{{label}} rank">
{{/if}}
<button type="button" class="sf-skill-buy" data-action="buySkill" data-skill="{{key}}" title="Purchase next {{label}} rank with XP" aria-label="Purchase next {{label}} rank"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
</div>{{/each}}
</section>{{/each}}
</div>{{/each}}
</div>
</section>{{/if}}
    {{#if inventory}}<section class="sf-panel">
<div class="sf-section-heading">
<h2>Equipment & abilities</h2>
{{#if hasGMNotes}}<button type="button" data-action="gmNotes">GM source notes</button>{{/if}}
<button type="button" data-action="addItem">Add item</button>
</div>
<p class="sf-hint">Drag entries from the local compendiums onto this sheet. Open an item for statistics and its book reference.</p>
{{#each items}}<div class="sf-item-row">
<img src="{{img}}" alt="">
<div>
<button type="button" data-action="item" data-item="{{id}}">{{name}}</button>
<small>{{type}} · {{system.source.book}} {{system.source.page}}</small>
{{#if system.incomplete.length}}<small>Source statistics needed</small>{{/if}}
</div>
<span>×{{system.quantity}}</span>
{{#if weapon}}<button type="button" data-action="skill" data-item="{{id}}">Roll</button>{{/if}}
<button type="button" data-action="removeItem" data-item="{{id}}" aria-label="Remove {{name}}">×</button>
</div>{{else}}<p>Ready for the first loadout.</p>{{/each}}
</section>{{/if}}
    {{#if advancement}}<section class="sf-panel">
<h2>Build a character. Follow a path.</h2>
<div class="sf-form-grid">
<label>Available XP<input type="number" min="0" name="system.xp.available" value="{{system.xp.available}}">
</label>
<label>Total earned XP<input type="number" min="0" name="system.xp.total" value="{{system.xp.total}}">
</label>
<div class="sf-phase-status"><span>Advancement phase</span><strong>{{#if creation}}Character creation{{else}}Campaign play{{/if}}</strong><small>{{#if originsLocked}}Starting species and career locked{{else}}The GM starts campaign play from Campaign rulebooks{{/if}}</small></div>
</div>
{{#if isCharacter}}{{#unless originsLocked}}<button type="button" data-action="createCharacter" {{#unless originSelectionReady}}disabled title="Choose a valid species and career in the sheet header first"{{/unless}}>Complete starting choices</button>{{/unless}}{{/if}}
<p class="sf-hint">Purchase connected talents with available XP. Structured passive effects marked Auto feed the dice pool; use the cited book for every node whose wording is not supplied by a private library.</p>
</section>
{{#each advancementTrees}}<section class="sf-panel">
<h2>{{#if signature}}Signature ability · {{/if}}{{name}}</h2>
<p class="sf-hint">{{source.book}} · p. {{source.page}} · {{#if verified}}Structured graph imported{{else}}No structured graph available{{/if}} · {{sourceVerificationLabel}}
{{#if signature}} · Linked to {{#if linkSpecialization}}{{linkSpecialization}}{{else}}no specialization{{/if}} · {{#if linkUnlocked}}Base ability unlocked{{else}}Learn a marked bottom-row talent to unlock the base ability{{/if}}{{/if}}
</p>
{{#if nodes.length}}<div class="sf-tree" style="height:{{treeHeight}}px">
<svg viewBox="0 0 800 {{svgHeight}}" preserveAspectRatio="none" aria-hidden="true">
{{#each edges}}<line x1="{{x1}}" y1="{{y1}}" x2="{{x2}}" y2="{{y2}}"/>{{/each}}
</svg>
{{#each nodes}}<button type="button" class="sf-talent {{#if owned}}owned{{/if}} {{#if knownElsewhere}}owned{{/if}} {{#if available}}available{{/if}}" style="left:{{x}}%;top:{{y}}%;width:{{width}}%;height:{{height}}%" data-action="buyTalent" data-item="{{itemId}}" data-node="{{id}}" title="{{#if summary}}{{summary}}{{else}}{{name}} · use {{../source.book}}, p. {{../source.page}}{{/if}}" {{#if disabled}}disabled{{/if}}>
<span class="sf-talent-name">{{name}}</span>
<span class="sf-talent-description">{{#if summary}}{{summary}}{{else}}Use the cited book for this talent's effect.{{/if}}</span>
<small><span>{{#if owned}}Purchased{{else}}{{#if knownElsewhere}}Learned elsewhere{{else}}{{cost}} XP{{/if}}{{/if}}</span><span class="sf-talent-automation {{#if automatic}}automatic{{/if}}">{{automationLabel}}</span></small>
</button>{{/each}}
</div>{{else}}<p>Add the chart with the private PDF tree importer. A list of talent names alone does not define a valid upgrade path.</p>{{/if}}
</section>{{else}}<section class="sf-panel">
<p>Add a specialization or signature ability from the library to see its upgrade paths.</p>
</section>{{/each}}
<section class="sf-panel">
<h2>Advancement record</h2>
{{#each system.advancement}}<p>{{name}} <small>{{cost}} XP</small>
</p>{{else}}<p>No XP purchases yet.</p>{{/each}}
</section>{{/if}}
    {{#if story}}<section class="sf-panel">
<h2>Logbook</h2>
{{#if isVehicle}}<label>Notes<textarea name="system.notes" rows="15">{{system.notes}}</textarea>
</label>{{else}}<div class="sf-section-heading"><h3>Motivations</h3><button type="button" data-action="addMotivation" title="Add a motivation"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add</button></div>
<p class="sf-hint">Add as many active or dormant motivations as the character needs. Director of Realms receives their category, guidance and source reference.</p>
<div class="sf-motivation-list">
{{#each motivations}}<article class="sf-motivation {{#unless active}}inactive{{/unless}}">
<div><strong>{{name}}</strong>{{#if category}}<span>{{category}}</span>{{/if}}{{#unless active}}<span>Dormant</span>{{/unless}}</div>
{{#if description}}<p>{{description}}</p>{{/if}}
{{#if source.book}}<small>{{source.book}}{{#if source.page}} · p. {{source.page}}{{/if}}</small>{{/if}}
<span class="sf-motivation-actions"><button type="button" data-action="editMotivation" data-motivation-id="{{id}}" aria-label="Edit {{name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button><button type="button" data-action="removeMotivation" data-motivation-id="{{id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button></span>
</article>{{else}}<p>No structured motivations yet. Use Add or drag a motivation reference from the library.</p>{{/each}}
</div>
<label>Freeform motivation summary<input name="system.motivation" value="{{system.motivation}}">
</label>
<label>Biography & notes<textarea name="system.biography" rows="12">{{system.biography}}</textarea>
</label>
<div class="sf-form-grid">
<label>Emotional strength<input name="system.morality.strength" value="{{system.morality.strength}}">
</label>
<label>Emotional weakness<input name="system.morality.weakness" value="{{system.morality.weakness}}">
</label>
</div>{{/if}}
<h3>Source reference</h3>
<div class="sf-form-grid">
<label>Book<input name="system.source.book" value="{{system.source.book}}">
</label>
<label>Page<input name="system.source.page" value="{{system.source.page}}">
</label>
</div>
</section>{{/if}}
  </main>
<footer class="sf-footer">
<span>HILL TO DIE ON</span>
<span>Independent tooling · Keep the rulebooks at the table</span>
</footer>
</div>
