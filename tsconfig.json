{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [],
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": false
  },
  "include": [
    "src/dice/core.mjs",
    "tests/types/**/*.mts"
  ]
}