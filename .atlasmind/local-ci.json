{
  "schemaVersion": 1,
  "managedBy": "atlasmind:reviewed-pr-local-ci:v1",
  "enabled": true,
  "repository": "Hill-To-Die-On/Star-wars-FFG-game-system",
  "trustedBaseBranch": "dev",
  "workflowFile": "atlasmind-reviewed-pr-local-ci.yml",
  "runnerLabel": "atlasmind-reviewed-pr-x64",
  "statusContext": "AtlasMind/local-ci",
  "controllerNodeVersion": "24",
  "evidence": "linux-container",
  "allowForks": false,
  "commands": [
    {
      "label": "Install locked dependencies",
      "command": "npm",
      "args": [
        "ci"
      ],
      "timeoutMinutes": 20
    },
    {
      "label": "Run unit and contract tests",
      "command": "npm",
      "args": [
        "test"
      ],
      "timeoutMinutes": 20
    },
    {
      "label": "Run syntax, template and data checks",
      "command": "npm",
      "args": [
        "run",
        "check"
      ],
      "timeoutMinutes": 20
    },
    {
      "label": "Build the public system package",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "timeoutMinutes": 20
    },
    {
      "label": "Audit the actual public release archive",
      "command": "npm",
      "args": [
        "run",
        "audit:release"
      ],
      "timeoutMinutes": 10
    }
  ],
  "detection": {
    "kind": "node",
    "packageManager": "npm",
    "detail": "Reviewed Star Wars system matrix: tests, check, build and archive audit."
  }
}
